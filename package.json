{
  "name": "stumblezone",
  "version": "1.0.0",
  "description": "A four-round party gauntlet for Decentraland, built mobile-first.",
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@dcl/js-runtime": "latest",
    "@dcl/sdk": "latest",
    "tsx": "^4.23.13"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  },
  "volta": {
    "node": "22.23.2"
  }
}

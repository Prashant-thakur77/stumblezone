{
  "name": "stumblezone",
  "version": "1.0.0",
  "description": "A party game show for Decentraland Mobile that runs itself: a new round every two minutes, no host, no server.",
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "test": "node --import tsx --test tests/*.test.ts",
    "budget": "node tools/budget.mjs",
    "ui": "node tools/make-ui.mjs",
    "verify": "npm run build && npm test && npm run budget && npm run smoke && npm run smoke2",
    "smoke": "node tools/smoke.mjs",
    "smoke2": "tsx tools/smoke2.mts"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.27.0",
    "@dcl/sdk": "7.27.0",
    "tsx": "^4.23.13"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=6.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  },
  "volta": {
    "node": "22.23.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Prashant-thakur77/stumblezone.git"
  },
  "homepage": "https://decentraland.org/jump/?realm=justchatting.dcl.eth",
  "keywords": [
    "decentraland",
    "sdk7",
    "mobile",
    "game",
    "party",
    "multiplayer"
  ]
}
